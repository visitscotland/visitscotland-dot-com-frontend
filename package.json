{
  "name": "nuxt-bloomreach-headless-white-label",
  "private": true,
  "type": "module",
  "version": "0.0.24",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "postinstall": "node -p \"require('./node_modules/@visitscotland/component-library/package.json').version\" > .clversion && nuxt prepare",
    "commit": "cz",
    "release:patch": "standard-version --release-as patch",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "lint": "eslint .",
    "lint:fix": "yarn lint --fix",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:update": "playwright test --update-snapshots",
    "chromatic": "node scripts/run-chromatic.mjs",
    "chromatic:upload": "chromatic",
    "test:pinia": "node tests/pinia-migration.mjs",
    "test:dependencies": "node --test tests/dependency-*.test.mjs tests/prepare-dependency-triage.test.mjs tests/dependabot-auto-merge.test.mjs .github/skills/dependency-triage/scripts/collect.test.mjs",
    "test:smoke": "node ci/dependency-smoke.mjs",
    "test:smoke:browser": "node ci/dependency-smoke.mjs --skip-build",
    "test:smoke:harness": "node ci/dependency-smoke.mjs --skip-build --harness",
    "test:smoke:unit": "node --test tests/dependency-smoke/harness.test.mjs",
    "test:smoke:install": "playwright install chromium",
    "test:smoke:diagnostics": "node ci/smoke-diagnostics.mjs"
  },
  "lint-staged": {
    "*.{js,vue,ts}": "eslint"
  },
  "devDependencies": {
    "@chromatic-com/playwright": "^1.0.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@types/google.maps": "^3.67.0",
    "@types/node": "^26.6.6",
    "chromatic": "^18.15.1",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "nuxt": "^4.6.4",
    "nuxt-lazy-hydrate": "^1.0.0",
    "semver": "7.8.6",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@bloomreach/spa-sdk": "^28.2.0",
    "@bloomreach/vue3-sdk": "^22.0.5",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@pinia/nuxt": "^1.0.3",
    "@playwright/test": "^1.65.1",
    "@visitscotland/component-library": "5.85.0",
    "axios": "^1.21.1",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "html-entities": "^2.6.0",
    "lint-staged": "^17.6.1",
    "mitt": "^3.0.0",
    "nuxt-jsonld": "^3.0.0",
    "pinia": "^4.1.0",
    "sass": "^1.108.2",
    "standard-version": "^9.5.0",
    "typescript": "^6.0.3",
    "vue": "3.5.46"
  },
  "resolutions": {
    "vue": "3.5.46",
    "axios": "1.21.1",
    "lodash": "4.18.1",
    "js-yaml@npm:^4.1.0": "4.3.2"
  },
  "overrides": {
    "minimist": "latest"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "packageManager": "yarn@4.14.1"
}
